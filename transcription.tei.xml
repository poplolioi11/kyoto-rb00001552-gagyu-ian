  <text>
    <body>
      <div type="codex">
        <pb n="1" facs="#f01" />
        <div n="1" type="scan" subtype="titled-text">
          <div type="page-face" n="left" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f01-l-c01">
              <seg type="diplomatic-text">醫案</seg>
            </ab>
            <ab type="column" n="2" xml:id="f01-l-c02">
              <seg type="diplomatic-text">夫霍亂也者飲食傷之病名也與宿食不同</seg>
            </ab>
            <ab type="column" n="3" xml:id="f01-l-c03">
              <seg type="diplomatic-text">譬猶謂雲霧謂暴雨一而二也傷食宿食共</seg>
            </ab>
            <ab type="column" n="4" xml:id="f01-l-c04">
              <seg type="diplomatic-text">發自飲食然傷之與宿字勢可見矣宿食也</seg>
            </ab>
            <ab type="column" n="5" xml:id="f01-l-c05">
              <seg type="diplomatic-text">食物未化而重食遂停滯而病故吞酸呃噫</seg>
            </ab>
            <ab type="column" n="6" xml:id="f01-l-c06">
              <seg type="diplomatic-text">或泄利如抱壞雞子或米穀不化矣傷食也</seg>
            </ab>
            <ab type="column" n="7" xml:id="f01-l-c07">
              <seg type="diplomatic-text">為食物所傷故腹痛吐泻轉筋厥冷或頭痛</seg>
            </ab>
            <ab type="column" n="8" xml:id="f01-l-c08">
              <seg type="diplomatic-text">發熱惡寒身躰疼痛或吐泻後煩渴引飲小</seg>
            </ab>
            <ab type="column" n="9" xml:id="f01-l-c09">
              <seg type="diplomatic-text">便不利或欲吐而不吐欲利而不利腹滿絞</seg>
            </ab>
            <ab type="column" n="10" xml:id="f01-l-c10">
              <seg type="diplomatic-text">痛形證殆類傷寒是以傷寒論末附霍亂以</seg>
            </ab>
          </div>
          <div type="editorial-observations">
            <ab type="layout">左半葉右起第一欄為篇題；同幅右半葉為前篇。</ab>
            <ab type="transcription-issue" n="left:5">
              <quote>呃噫</quote>
              <seg type="candidate">呃</seg>
              <note type="editorial">同 25 幅右反覆可見的口旁字，覆核內部筆劃。</note>
            </ab>
            <ab type="transcription-issue" n="left:6">
              <quote>泄利</quote>
              <note type="editorial">泄字左下有淡小印，覆核是否有墨點。</note>
            </ab>
            <ab type="transcription-issue" n="left:7">
              <quote>吐泻</quote>
              <seg type="candidate">泻</seg>
              <seg type="candidate">污</seg>
              <note type="editorial">水旁末字在本面及下幅右重見。</note>
            </ab>
          </div>
        </div>
        <pb n="2" facs="#f02" />
        <div n="2" type="scan" subtype="titled-text">
          <div type="page-face" n="right" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f02-r-c01">
              <seg type="diplomatic-text">令不混可見其殷懃叮嚀矣予閲霍亂篇首</seg>
            </ab>
            <ab type="column" n="2" xml:id="f02-r-c02">
              <seg type="diplomatic-text">章曰呃吐而利名曰霍亂矣此之章恐有脫</seg>
            </ab>
            <ab type="column" n="3" xml:id="f02-r-c03">
              <seg type="diplomatic-text">語不然則後人之所攙乎何則以吐泻者為</seg>
            </ab>
            <ab type="column" n="4" xml:id="f02-r-c04">
              <seg type="diplomatic-text">霍亂則如少陰病吐利手足厥冷亦為霍亂</seg>
            </ab>
            <ab type="column" n="5" xml:id="f02-r-c05">
              <seg type="diplomatic-text">乎如彼傷食不吐不下者名乾霍亂乾即乾</seg>
            </ab>
            <ab type="column" n="6" xml:id="f02-r-c06">
              <seg type="diplomatic-text">呃之乾無物之謂而即不吐下也至此霍亂</seg>
            </ab>
            <ab type="column" n="7" xml:id="f02-r-c07">
              <seg type="diplomatic-text">之名儀不觧古人觧霍亂為揮霍撩亂者予</seg>
            </ab>
            <ab type="column" n="8" xml:id="f02-r-c08">
              <seg type="diplomatic-text">以為不然何則是謂煩悶痛苦之態歟將謂</seg>
              <note type="original-mark" n="13" rend="black">•</note>
            </ab>
            <ab type="column" n="9" xml:id="f02-r-c09">
              <seg type="diplomatic-text">陰陽乖戻經絡雜混歟不當出於此之二也</seg>
            </ab>
            <ab type="column" n="10" xml:id="f02-r-c10">
              <seg type="diplomatic-text">嗚呼雖諸患有輕重病則陰陽乖戻甚則煩</seg>
            </ab>
          </div>
          <div type="page-face" n="left" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f02-l-c01">
              <seg type="diplomatic-text">悶痛苦豈傷食而已哉山田氏曰霍與臛古</seg>
            </ab>
            <ab type="column" n="2" xml:id="f02-l-c02">
              <seg type="diplomatic-text">字通用説文云臛肉羹也即引漿酒霍肉惟</seg>
            </ab>
            <ab type="column" n="3" xml:id="f02-l-c03">
              <seg type="diplomatic-text">酒無量不及亂淫溺惑亂等之語以觧霍亂</seg>
              <note type="original-mark" n="13" rend="black">•</note>
            </ab>
            <ab type="column" n="4" xml:id="f02-l-c04">
              <seg type="diplomatic-text">此之説最為穏當也夫傷寒論也文辭簡古</seg>
            </ab>
            <ab type="column" n="5" xml:id="f02-l-c05">
              <seg type="diplomatic-text">儀理深淵且也古經殘缺叔和撰次故有脫</seg>
            </ab>
            <ab type="column" n="6" xml:id="f02-l-c06">
              <seg type="diplomatic-text">語有衍文有攙入不可謂仲景氏之完璧矣</seg>
            </ab>
            <ab type="column" n="7" xml:id="f02-l-c07">
              <seg type="diplomatic-text">是以和漢説紛々然不帰一也孰為是焉孰</seg>
            </ab>
            <ab type="column" n="8" xml:id="f02-l-c08">
              <seg type="diplomatic-text">為非焉不如多聞多視而取捨唯在己哉凡</seg>
            </ab>
            <ab type="column" n="9" xml:id="f02-l-c09">
              <seg type="diplomatic-text">為食所傷十之八九係肉食故特挙臛以統</seg>
            </ab>
            <ab type="column" n="10" xml:id="f02-l-c10">
              <seg type="diplomatic-text">一應食物也予從事霍亂為□鯖松魚呉魚</seg>
            </ab>
          </div>
          <div type="editorial-observations">
            <ab type="layout">右半葉先，左半葉後；欄間可見墨點。</ab>
            <ab type="transcription-issue" n="right:3">
              <quote>所攙乎</quote>
              <seg type="candidate">攙</seg>
              <seg type="candidate">挾</seg>
              <note type="editorial">與 25 幅左第六欄所見相互查核。</note>
            </ab>
            <ab type="transcription-issue" n="right:7">
              <quote>之名儀</quote>
              <seg type="candidate">儀</seg>
              <seg type="candidate">義</seg>
              <note type="editorial">左側疑有人旁。</note>
            </ab>
            <ab type="transcription-issue" n="right:9">
              <quote>乖戻</quote>
              <seg type="candidate">戻</seg>
              <seg type="candidate">戾</seg>
              <note type="editorial">下欄同形，需核內側筆劃。</note>
            </ab>
            <ab type="transcription-issue" n="left:1">
              <quote>霍與臛</quote>
              <seg type="candidate">臛</seg>
              <seg type="candidate">膗</seg>
              <note type="editorial">此字本文重見三次，需看肉旁及右側寫法。</note>
            </ab>
            <ab type="transcription-issue" n="left:5">
              <quote>儀理</quote>
              <seg type="candidate">儀</seg>
              <seg type="candidate">義</seg>
              <note type="editorial">與 25 幅右第七欄所見相似。</note>
            </ab>
            <ab type="transcription-issue" n="left:10">
              <quote>為□鯖</quote>
              <seg type="candidate">鯛</seg>
              <seg type="candidate">鯣</seg>
              <note type="editorial">連列魚名，首見魚旁字待定，後字已暫讀。</note>
            </ab>
          </div>
        </div>
        <pb n="3" facs="#f03" />
        <div n="3" type="scan" subtype="text-and-colophon">
          <div type="page-face" n="right" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f03-r-c01">
              <seg type="diplomatic-text">河豚海螺等所傷者居多或過飡肥膾或不</seg>
            </ab>
            <ab type="column" n="2" xml:id="f03-r-c02">
              <seg type="diplomatic-text">伏水土皆能致此之症矣嘗偶見□魚肉理</seg>
            </ab>
            <ab type="column" n="3" xml:id="f03-r-c03">
              <seg type="diplomatic-text">有細蟲脷□魚肝中亦有細蟲數條若誤飡</seg>
            </ab>
            <ab type="column" n="4" xml:id="f03-r-c04">
              <seg type="diplomatic-text">如此之物雖無毒魚為之所害者必矣又有</seg>
            </ab>
            <ab type="column" n="5" xml:id="f03-r-c05">
              <seg type="diplomatic-text">食韮吐血而死者有食海獺吐下鮮血身躰</seg>
            </ab>
            <ab type="column" n="6" xml:id="f03-r-c06">
              <seg type="diplomatic-text">發紫黑斑點而死者是非尋常霍亂蓋同食</seg>
            </ab>
            <ab type="column" n="7" xml:id="f03-r-c07">
              <seg type="diplomatic-text">毒蟲者也嗚呼雖五味能養生傷亦在五味</seg>
            </ab>
            <ab type="column" n="8" xml:id="f03-r-c08">
              <seg type="diplomatic-text">一飲一食之間不敢縱口腹之欲故論語鄉</seg>
              <note type="original-mark" n="13" rend="black">•</note>
            </ab>
            <ab type="column" n="9" xml:id="f03-r-c09">
              <seg type="diplomatic-text">黨有飲食之戒矣世俗以霍亂為中暑病者</seg>
            </ab>
            <ab type="column" n="10" xml:id="f03-r-c10">
              <seg type="diplomatic-text">誤矣夫夏月不堪於暑多啜生冷之物或引</seg>
            </ab>
          </div>
          <div type="page-face" n="left" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f03-l-c01">
              <seg type="diplomatic-text">飲救渇眠涼席臥風前胃氣□結而發是以</seg>
            </ab>
            <ab type="column" n="2" xml:id="f03-l-c02">
              <seg type="diplomatic-text">夏月多而冬月少也非中暑之病矣不可不</seg>
            </ab>
            <ab type="column" n="3" xml:id="f03-l-c03">
              <seg type="diplomatic-text">論也頃日同僚記松山生之治中河豚者予</seg>
              <note type="original-mark" n="13" rend="black">•</note>
            </ab>
            <ab type="column" n="4" xml:id="f03-l-c04">
              <seg type="diplomatic-text">又何謂哉故聊述愚意云爾</seg>
            </ab>
            <ab type="column" n="5" xml:id="f03-l-c05">
              <seg type="diplomatic-text">文化乙亥四月十九日　中山照久誌</seg>
            </ab>
          </div>
          <div type="editorial-observations">
            <ab type="layout">左半葉第四欄止正文，第五欄為紀年署記，左側五空欄。本篇在此結束。</ab>
            <ab type="transcription-issue" n="right:1">
              <quote>過飡</quote>
              <seg type="candidate">飡</seg>
              <seg type="candidate">餐</seg>
              <note type="editorial">第三欄末同形。</note>
            </ab>
            <ab type="transcription-issue" n="right:2">
              <quote>見□魚</quote>
              <seg type="candidate">鰹</seg>
              <seg type="candidate">鰙</seg>
              <note type="editorial">魚旁字右部待辨。</note>
            </ab>
            <ab type="transcription-issue" n="right:3">
              <quote>脷□魚</quote>
              <seg type="candidate">脷</seg>
              <seg type="candidate">肺</seg>
              <seg type="candidate">章</seg>
              <seg type="candidate">荘</seg>
              <seg type="candidate">苹</seg>
              <note type="editorial">第 4–5 字各待覆核。</note>
            </ab>
            <ab type="transcription-issue" n="right:5">
              <quote>食海獺</quote>
              <seg type="candidate">獺</seg>
              <seg type="candidate">獭</seg>
              <note type="editorial">末字構形待覆核。</note>
            </ab>
            <ab type="transcription-issue" n="left:1">
              <quote>胃氣□結</quote>
              <seg type="candidate">鬱</seg>
              <seg type="candidate">鬰</seg>
              <note type="editorial">密筆字筆形待覆核。</note>
            </ab>
          </div>
        </div>
      </div>
    </body>
  </text>
